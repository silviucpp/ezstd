{pre_hooks, [
    {"(linux|darwin)", compile, "make compile_nif"},
    {"(win32|windows)", compile, "powershell -NoProfile -ExecutionPolicy Bypass -File build_win32.ps1"}
]}.
{post_hooks, [
    {"(linux|darwin)", clean, "make clean_nif"},
    {"(win32|windows)", clean, "powershell -NoProfile -ExecutionPolicy Bypass -File build_win32.ps1 -Clean"}
]}.

%% rebar.config.script makes this priv/ezstd_nif.dll on Windows.
{artifacts, ["priv/ezstd_nif.so"]}.

{project_plugins, [rebar3_hex, rebar3_ex_doc]}.

{deps, []}.

{erl_opts, [
    warnings_as_errors,
    warn_export_all
]}.

{profiles, [
    {test, [
        {erl_opts, [
            debug_info,
            nowarn_export_all
        ]}
    ]}
]}.

{edoc_opts, [
    {private, false}
]}.

{ex_doc, [
     {source_url, <<"https://github.com/silviucpp/ezstd">>},
     {main, <<"ezstd">>}
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.
